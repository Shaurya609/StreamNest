* text=auto
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.yml text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
*.png binary
*.jar binary

# Preserve upstream license formatting.
desktop/LICENSE.txt -whitespace
# Installer checksums cover these exact bytes on every checkout platform.
desktop/overlay/** -text -whitespace

# Catalog signatures cover exact UTF-8 bytes.
catalogs/bundled-manifest.json -text
app/src/main/assets/catalog-*.json -text
catalogs/public-key.pem text eol=lf

# Preserve pinned legacy sources and their license/source formatting.
desktop/upstream/** -text -whitespace
